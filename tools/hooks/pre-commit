#!/bin/sh
# every commit gets a new site version (open pages then show "새 버전이 나왔어요 · 새로고침")
cd "$(git rev-parse --show-toplevel)" || exit 1
PY=
for c in python3 python py; do if $c -c "import sys" >/dev/null 2>&1; then PY=$c; break; fi; done
[ -z "$PY" ] && { echo "pre-commit: Python을 찾지 못해서 사이트 버전을 올리지 못했어요" >&2; exit 1; }
PYTHONUTF8=1 $PY tools/bump_version.py && git add version.json js/data/version.js index.html
